# Copy to .env.local for local development and set these in the Vercel project
# dashboard for the deployed site.

# --- Search engines -------------------------------------------------------
# Leave unset (or anything other than "true") and the site is noindex.
# Only set this to true once the real photography, rates and contact details
# are in. See README, "Before this goes live".
NEXT_PUBLIC_ALLOW_INDEXING=

# --- AI-BOS hospitality module -------------------------------------------
# Unset = the booking flow runs locally and a person confirms by hand.
# Set both to connect live availability and booking requests.
#
# Both come from AI-BOS: Hospitality -> Channels -> "Your own website" ->
# Connect my website. The card shows each value with a copy button.
#
# The URL is the API's own address, NOT the AI-BOS website's: that site's
# /api/proxy attaches a signed-in owner's session and this one has none.
# Vercel bakes NEXT_PUBLIC_* into the build, so redeploy after setting them.
NEXT_PUBLIC_AIBOS_API_URL=
NEXT_PUBLIC_AIBOS_SITE_TOKEN=

# --- Booking + enquiry notifications -------------------------------------
# WITHOUT THESE, THE BOOKING FORM CANNOT DELIVER ANYTHING. It will not fail
# silently. The guest is told plainly that it did not send and is pointed at
# WhatsApp, but no one is notified. Set these before taking real bookings.
#
# Create a free account at resend.com, verify the sending domain, then:
RESEND_API_KEY=
# Where booking requests and long-stay enquiries are sent:
BOOKING_NOTIFY_EMAIL=
# A sender address on the domain verified with Resend, e.g. site@dunslim-apartments.com
BOOKING_FROM_EMAIL=
